# Private key of the deployer wallet (hex, with or without 0x prefix).
# Use a dedicated deploy wallet with only enough BNB for gas. NEVER commit the real .env file.
PRIVATE_KEY=

# RPC endpoints. Public endpoints work but a dedicated provider (NodeReal, QuickNode, Ankr...) is more reliable.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Etherscan API v2 key (created at https://etherscan.io/apidashboard) - it also works for BscScan.
BSCSCAN_API_KEY=

# Address that receives the full 1,000,000,000 NEWC at deployment.
# On mainnet this MUST be a multisig (e.g. Safe 3/5), never an EOA.
TREASURY_ADDRESS=

# --- Vesting deployment (scripts/deploy-vesting.js) ---
# Path to the allocation config. Copy config/allocations.example.json and edit it.
ALLOCATIONS_FILE=config/allocations.example.json
# Unix timestamp (seconds) of the Token Generation Event. Leave empty to use the current block time.
TGE_TIMESTAMP=
# Set to "true" to also transfer tokens from the deployer into the vesting wallets.
# Requires the deployer to hold the tokens. When the treasury is a multisig, leave this
# empty and execute the printed transfers from the multisig instead.
FUND_VESTING=

# --- PancakeSwap V2 liquidity bootstrap (scripts/add-liquidity.js) ---
# Amount of NEWC to seed the NEWC/BNB pool with, in whole tokens (e.g. 80000000 = 8% of supply).
# The signer (PRIVATE_KEY) must hold these tokens: transfer them from the treasury first.
LIQUIDITY_TOKEN_AMOUNT=
# Amount of BNB to pair with, in whole BNB (decimals allowed, e.g. 100 or 12.5).
# Together these two numbers SET THE LAUNCH PRICE: price = LIQUIDITY_BNB_AMOUNT / LIQUIDITY_TOKEN_AMOUNT.
LIQUIDITY_BNB_AMOUNT=
# Address that receives the LP (Cake-LP) tokens. Leave empty to use the signer.
# Whoever holds the LP tokens can withdraw the whole pool: send them to the multisig, then lock them.
LP_RECIPIENT=
# Slippage tolerance in basis points for amountTokenMin / amountETHMin (100 = 1%). Default 100.
SLIPPAGE_BPS=100
# Transaction deadline in minutes. Default 20.
DEADLINE_MINUTES=20
# Override the PancakeSwap V2 router. Default: 0x10ED43C718714eb63d5aA57B78B54704E256024E on
# mainnet (56), 0xD99D1c33F9fC3444f8101754aBC46c52416550D1 on testnet (97). Only needed on other chains.
ROUTER_ADDRESS=
# Must be exactly "yes" to allow add-liquidity on BNB mainnet (chainId 56). Real BNB, irreversible.
CONFIRM_MAINNET=

# Optional: print gas usage during tests.
REPORT_GAS=false
