# Token bot Telegram, lay tu @BotFather (xem README.md muc "Tao bot qua BotFather")
TELEGRAM_BOT_TOKEN=

# (Tuy chon) Danh sach Telegram user id cua "super admin" bot, cach nhau bang dau phay.
# Nhung nguoi nay luon duoc coi la admin trong moi nhom, du Telegram co liet ho vao
# admin nhom hay khong (huu ich khi test rieng).
# Vi du: BOT_SUPER_ADMIN_IDS=123456789,987654321
BOT_SUPER_ADMIN_IDS=

# (Tuy chon) Khoang thoi gian (phut) giua cac lan kiem tra thuong hoat dong hang ngay.
# Mac dinh 60 phut/lan; job se tu kiem tra xem hom nay da phat cho tung nhom chua (idempotent).
DAILY_REWARD_CHECK_INTERVAL_MINUTES=60

# (Tuy chon) Ten mien cong khai de chay o CHE DO WEBHOOK.
# - De TRONG => bot chay o che do LONG POLLING (bot tu hoi Telegram) — dung khi chay o may ca nhan.
# - Co gia tri => bot mo HTTP server va dang ky webhook voi Telegram, tuc la chinh Telegram
#   gui request vao bot. Bat buoc phai dung che do nay khi deploy len hosting mien phi kieu
#   Render (chi co web service, va service tu "ngu" sau ~15 phut khong co request).
# Chi can ten mien, khong can duong dan; bot tu them https:// neu ban quen.
# Vi du: WEBHOOK_DOMAIN=lixi-bot-telegram.onrender.com
# Luu y: tren Render KHONG can dat bien nay — Render tu tiem RENDER_EXTERNAL_URL va bot tu nhan ra.
# Duong dan webhook va "secret token" duoc suy ra tu TELEGRAM_BOT_TOKEN (bam SHA-256), khong
# can cau hinh them, va khong bao gio bi in ra log.
WEBHOOK_DOMAIN=

# (Tuy chon) Cong HTTP de lang nghe o che do webhook. Mac dinh 3000.
# Tren Render KHONG can dat — Render tu tiem bien PORT va bot tu dung dung cong do.
PORT=

# (Tuy chon) Chuoi ket noi PostgreSQL. CO bien nay => bot luu du lieu vao Postgres
# (ben vung, dung duoc tren Vercel/Render); KHONG co => bot luu vao file JSON trong
# bot/data/ nhu truoc gio (phu hop khi chay o may ca nhan).
# Tren Vercel: KHONG phai go tay — gan database Neon o tab Storage, Vercel tu them bien nay.
# Cac ten bien khac cung duoc chap nhan, theo thu tu uu tien:
#   DATABASE_URL > POSTGRES_URL > POSTGRES_PRISMA_URL > POSTGRES_URL_NON_POOLING
#   > DATABASE_URL_UNPOOLED > NEON_DATABASE_URL   (xem src/storage.js)
# Vi du chay Postgres tren may minh:
#   DATABASE_URL=postgresql://postgres:matkhau@127.0.0.1:5432/lixi
DATABASE_URL=

# (Tuy chon) Schema Postgres de dung. Mac dinh 'public'. Chi doi khi ban muon nhieu bot
# dung chung mot database ma khong dung cham nhau.
POSTGRES_SCHEMA=

# (Chi dung tren Vercel) Chuoi ngau nhien bat ky. Khi co bien nay, Vercel gui kem header
# "Authorization: Bearer <CRON_SECRET>" moi lan chay lich hang ngay, va /api/cron dung no
# de chan nguoi la tu bam phat thuong. THIEU bien nay thi thuong hoat dong KHONG duoc phat.
CRON_SECRET=

# (Chi dung tren Vercel, tuy chon) Ma bi mat de mo trang /api/setup?key=...
# Khong dat thi dung ma suy ra tu token bot (xem README muc "Chay tren Vercel").
SETUP_KEY=

# (Chi dung khi test) Chuoi ket noi Postgres danh rieng cho `npm test`.
# Khong dat thi nhom test tich hop Postgres se tu BO QUA (skip), khong lam do CI.
# Vi du: TEST_DATABASE_URL=postgresql://postgres:matkhau@127.0.0.1:5432/lixi_test
TEST_DATABASE_URL=
