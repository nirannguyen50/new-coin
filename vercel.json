{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "website",
  "redirects": [
    { "source": "/them-bot.html", "destination": "/", "permanent": false },
    { "source": "/them-bot", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/token", "destination": "/token.html" }
  ],
  "functions": {
    "api/telegram.js": {
      "maxDuration": 30
    },
    "api/setup.js": {
      "maxDuration": 30
    },
    "api/cron.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 1 * * *"
    }
  ]
}
